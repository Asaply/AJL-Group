# --- App (also set these two on Vercel) ---
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# --- Local seeding only — NEVER set these on Vercel ---
# Service role key bypasses RLS; used only by scripts/seed.ts.
SUPABASE_SERVICE_ROLE_KEY=

# Passwords used only by scripts/seed.ts to create the 3 partner accounts.
# Intentionally blank: `npm run seed` refuses to run until you fill them in
# .env.local (gitignored). Never commit real values.
SEED_PASSWORD_ALAN=
SEED_PASSWORD_JAZIEL=
SEED_PASSWORD_LEO=
